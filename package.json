{
  "name": "forge-ai-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "start:worker": "tsx server/worker.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "typecheck:server": "tsc -p tsconfig.server.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "PLAYWRIGHT_PRODUCTION_ACCEPTANCE=1 playwright test e2e/production.spec.ts",
    "test:server": "vitest run server",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seedDatabase.ts",
    "datasets:reset-catalog": "tsx server/resetDatasetCatalog.ts",
    "artifacts:cleanup": "tsx server/cleanupArtifacts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.10",
    "fast-xml-parser": "^4.5.3",
    "fastify": "^5.10.0",
    "image-size": "^2.0.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.22.0",
    "pngjs": "^7.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
