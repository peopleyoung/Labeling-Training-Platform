COMPOSE_PROJECT_NAME=forge-ai

POSTGRES_PASSWORD=replace-with-a-strong-internal-password
MINIO_ROOT_USER=forge-minio
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=平台管理员
# Keep false in normal deployments. Set true only when an intentional 5-11 character bootstrap password is required.
ALLOW_WEAK_BOOTSTRAP_PASSWORD=false

# Keep false on CPU-only hosts. Set true only together with `docker compose --profile gpu up`.
FORGE_GPU_ENABLED=false
FORGE_CPU_TRAINING_ENABLED=true
FORGE_CPU_ONNX_ENABLED=true
# Set true to prohibit automatic runtime downloads; missing pretrained weights then fail explicitly.
FORGE_PRETRAINED_OFFLINE=false
# Optional internal/Hugging Face-compatible mirror, e.g. https://hf-mirror.com.
HF_ENDPOINT=https://huggingface.co
# GPU Worker only. Mount a complete Diffusers SDXL Base directory at this path.
FORGE_SDXL_BASE_MODEL=/data/model-cache/stable-diffusion-xl-base-1.0

# The default same-origin path is proxied by the Web container to the API service.
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api/v1

# Host bindings. Keep the MinIO administration console on loopback unless it is needed.
WEB_BIND=0.0.0.0
WEB_PORT=5173
API_BIND=0.0.0.0
API_PUBLIC_PORT=4000
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=19001
